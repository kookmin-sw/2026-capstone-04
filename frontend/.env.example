# Django backend API base URL (include /api)
API_BASE_URL=
# Optional: save the latest captured screen region to debug-captures/latest.png
DEBUG_SAVE_CAPTURE=false
# Optional: print OCR loop debug logs in Electron main process
DEBUG_OCR_LOG=false
# Optional: manual analysis API endpoint
MANUAL_ANALYSIS_ENDPOINT=/manual-analysis/
# Optional: analysis history API base endpoint (list/detail/delete)
ANALYSIS_HISTORY_ENDPOINT=/sessions/
# Optional: user profile API endpoint (GET/PATCH)
USER_PROFILE_ENDPOINT=/auth/profile/
# Optional: privacy consent API endpoint (POST)
PRIVACY_CONSENT_ENDPOINT=/auth/privacy-consent/
# Optional: password change API endpoint
PASSWORD_CHANGE_ENDPOINT=/auth/password/
# Optional: coaching chat API base endpoint
COACHING_CHAT_ENDPOINT=/coaching/chats/